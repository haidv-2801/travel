    "@tanstack/react-query": "^5.104.2",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-leaflet": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
