generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL") // runtime connection (may be a pooler)
  directUrl = env("DIRECT_URL") // used by prisma migrate; a direct/session connection (same as DATABASE_URL when there is no pooler)
}

enum TripRole {
  EDITOR
  VIEWER
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  trips        Trip[]
  favorites    Favorite[]
  reviews      Review[]
  notifications Notification[]
  memberships  TripMember[]
  paidExpenses Expense[]      @relation("ExpensePayer")
  expenseShares ExpenseShare[]
  itemVotes    TripItemVote[]
  itemComments TripItemComment[]
}

model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  destinations Destination[]
}

model Destination {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  city        String
  region      String
  lat         Float
  lng         Float
  imageUrl    String?
  searchText  String    @default("") // normalized name + city for accent-insensitive search
  avgCost     Int       @default(0) // VND per person
  rating      Float     @default(0)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  reviewCount Int       @default(0)
  items       TripItem[]
  favorites   Favorite[]
  reviews     Review[]

  @@index([city])
  @@index([categoryId])
}

model Trip {
  id        String     @id @default(cuid())
  title     String
  startDate DateTime
  endDate   DateTime
  budget    Int        @default(0) // VND
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     TripItem[]
  expenses  Expense[]
  shareToken String?   @unique // set => publicly viewable read-only at /s/<token>
  inviteToken String?  @unique // set => anyone with the link (signed in) can join with inviteRole
  inviteRole TripRole  @default(EDITOR)
  members   TripMember[]
  createdAt DateTime   @default(now())

  @@index([userId])
}

model TripItem {
  id            String       @id @default(cuid())
  tripId        String
  trip          Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination  @relation(fields: [destinationId], references: [id])
  day           Int // 1-based day index
  position      Int // order within the day
  note          String?
  votes         TripItemVote[]
  comments      TripItemComment[]

  @@index([tripId, day, position])
}

model TripItemVote {
  itemId String
  userId String
  item   TripItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value  Int // +1 = want to go, -1 = would skip

  @@id([itemId, userId])
  @@index([userId])
}

model TripItemComment {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  item      TripItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
  @@index([userId])
}

model Expense {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title     String
  category  String // transport | food | lodging | tickets | other
  planned   Int      @default(0)
  actual    Int      @default(0)
  paidById  String? // who actually paid (null = not tracked for splitting)
  paidBy    User?    @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: SetNull)
  shares    ExpenseShare[] // who it is split between; empty = everyone in the trip
  createdAt DateTime @default(now())

  @@index([tripId])
}

model ExpenseShare {
  expenseId String
  userId    String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([expenseId, userId])
  @@index([userId])
}

model Favorite {
  userId        String
  destinationId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([userId, destinationId])
}

model Review {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  rating        Int // 1..5
  comment       String
  imageUrl      String?
  createdAt     DateTime    @default(now())

  @@unique([userId, destinationId])
  @@index([destinationId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  dedupeKey String // prevents generating the same reminder twice
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}

model TripMember {
  tripId    String
  userId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TripRole @default(EDITOR)
  createdAt DateTime @default(now())

  @@id([tripId, userId])
  @@index([userId])
}
