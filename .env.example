# --- Local development (docker compose up -d db) ---
DATABASE_URL="postgresql://tripmate:tripmate@localhost:5432/tripmate"
DIRECT_URL="postgresql://tripmate:tripmate@localhost:5432/tripmate"

# --- Supabase (replace the two lines above; never commit the real password) ---
# Percent-encode special characters in the password (e.g. @ -> %40).
# Single server / Docker: use the direct connection for both.
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.csapbslywwstpfqbuont.supabase.co:5432/postgres?sslmode=require"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.csapbslywwstpfqbuont.supabase.co:5432/postgres?sslmode=require"
# Serverless (Vercel...): runtime goes through the transaction pooler (Dashboard > Connect), migrations stay direct:
# DATABASE_URL="postgresql://postgres.csapbslywwstpfqbuont:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.csapbslywwstpfqbuont.supabase.co:5432/postgres?sslmode=require"

# --- Photo upload (Supabase Storage; optional, without it the review form keeps the https link field) ---
# SUPABASE_URL="https://csapbslywwstpfqbuont.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="[SECRET: Dashboard > Settings > API > service_role. Server only, never NEXT_PUBLIC_*]"
# SUPABASE_STORAGE_BUCKET="review-photos"   # public bucket, see README

# --- Background reminders (optional; the endpoint is disabled without it) ---
# CRON_SECRET="[long random string: openssl rand -base64 32]"

# Generate with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"
