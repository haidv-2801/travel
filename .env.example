# Supabase: Project Settings > API (or `npx supabase status` for a local stack).
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server only, used by `npm run db:seed`. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
